# herd guest kernel: the configuration shared by amd64 and arm64. build.sh merges it onto allnoconfig together with
# the architecture fragment (amd64.config or arm64.config), which may only add what cannot be shared.

# Core
CONFIG_PRINTK=y
CONFIG_MULTIUSER=y
CONFIG_SMP=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_FILE_LOCKING=y
CONFIG_POSIX_TIMERS=y
CONFIG_INOTIFY_USER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_RTC_CLASS=y

# Virtio over PCI: both Cloud Hypervisor and Virtualization.framework expose virtio-pci devices
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# Memory given back: the guest reports its free pages through a virtio balloon (vmm.FreePageReporting); compaction
# gathers free memory into the blocks that are reported.
CONFIG_VIRTIO_BALLOON=y
CONFIG_PAGE_REPORTING=y
CONFIG_COMPACTION=y

# Network: one virtio-net into herd-egress (TAP on Ubuntu, file-handle attachment on macOS)
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y

# Control: vsock (hybrid vsock on Cloud Hypervisor, native on Virtualization.framework; the guest sees virtio-vsock)
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# File systems: read-only erofs/ext4 rootfs images, a writable overlay, volumes over one virtio-fs share
CONFIG_EXT4_FS=y
# EROFS sits under the "Miscellaneous filesystems" menu, which allnoconfig turns off.
CONFIG_MISC_FILESYSTEMS=y
CONFIG_EROFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Containers run by crun under herd-guest (cgroup v2, namespaces, seccomp, BPF device control)
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
