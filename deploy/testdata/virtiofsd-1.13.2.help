A virtio-fs vhost-user device daemon

Usage: virtiofsd [OPTIONS]

Options:
      --shared-dir <SHARED_DIR>
      --tag <TAG>
      --socket <SOCKET>
      --socket-path <SOCKET_PATH>
      --socket-group <SOCKET_GROUP>
      --fd <FD>
      --thread-pool-size <THREAD_POOL_SIZE>
      --xattr
      --posix-acl
      --xattrmap <XATTRMAP>
      --sandbox <SANDBOX>
      --readonly
      --seccomp <SECCOMP>
      --announce-submounts
      --no-announce-submounts
      --inode-file-handles <INODE_FILE_HANDLES>
      --cache <CACHE>
      --allow-mmap
      --no-readdirplus
      --writeback
      --allow-direct-io
      --print-capabilities
      --modcaps <MODCAPS>
      --log-level <LOG_LEVEL>
      --syslog
      --rlimit-nofile <RLIMIT_NOFILE>
      --no-killpriv-v2
      --killpriv-v2
      --security-label
      --uid-map <UID_MAP>
      --gid-map <GID_MAP>
      --translate-uid <TRANSLATE_UID>
      --translate-gid <TRANSLATE_GID>
      --preserve-noatime
      --migration-mode <MIGRATION_MODE>
      --migration-on-error <MIGRATION_ON_ERROR>
      --migration-verify-handles
      --migration-confirm-paths
  -h, --help
          Print help (see a summary with '-h')
  -V, --version
          Print version
