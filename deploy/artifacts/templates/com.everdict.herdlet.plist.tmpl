<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- herdlet on a joined Mac (docs/runbooks/join.md): replace @HERD_API@ with herd-api's host:port. It joins as the
     Mac's SPIFFE identity from its SPIRE agent (spiffe://<td>/herd/node/<worker>, ADR 0001 A-60). -secrets is the
     directory its in-process herd-egress resolves ate-secret://dir/<name>/<tail> credentials from, and
     registry-auth.json (0600, a docker config file) the registry logins for private template images; without it pulls
     are anonymous. Rendered by deploy/artifacts; edit the template. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.everdict.herdlet</string>
	<key>ProgramArguments</key>
	<array>
		<string>[[.MacBinDir]]/herdlet</string>
		<string>run</string>
		<string>-api</string>
		<string>@HERD_API@</string>
		<string>-state</string>
		<string>[[.MacHerdletStateDir]]</string>
		<string>-kernel</string>
		<string>[[.MacGuestDir]]/kernel</string>
		<string>-initrd</string>
		<string>[[.MacGuestDir]]/initrd.img</string>
		<string>-secrets</string>
		<string>[[.MacEtcDir]]/secrets</string>
		<string>-registry-auth</string>
		<string>[[.MacEtcDir]]/registry-auth.json</string>
	</array>
	<!-- Root with the primary group herd-node (gid 64440): its SPIRE entry selects unix:uid:0 and unix:gid:64440. -->
	<key>GroupName</key>
	<string>herd-node</string>
	<key>InitGroups</key>
	<false/>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<!-- Interactive: launchd does not throttle the VMs' work; 256 open files is short for a host of VMs. -->
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>65536</integer>
	</dict>
	<key>HardResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>65536</integer>
	</dict>
	<key>StandardErrorPath</key>
	<string>/var/log/herdlet.log</string>
</dict>
</plist>
