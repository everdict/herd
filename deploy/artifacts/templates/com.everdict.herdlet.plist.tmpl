<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- herdlet on a joined Mac (docs/runbooks/join.md): replace @HERD_API@ with herd-api's host:port. Rendered by
     deploy/artifacts; edit the template. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.everdict.herdlet</string>
	<key>ProgramArguments</key>
	<array>
		<string>[[.MacBinDir]]/herdlet</string>
		<string>join</string>
		<string>@HERD_API@</string>
		<string>-token-file</string>
		<string>[[.MacEtcDir]]/join.token</string>
		<string>-state</string>
		<string>[[.MacHerdletStateDir]]</string>
		<string>-kernel</string>
		<string>[[.MacGuestDir]]/kernel</string>
		<string>-initrd</string>
		<string>[[.MacGuestDir]]/initrd.img</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/log/herdlet.log</string>
</dict>
</plist>
