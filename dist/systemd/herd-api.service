# herd-api for multi-host join (docs/runbooks/join.md). In /etc/herd/herd-api.env, HERD_ADVERTISE_TUNNEL is the
# herd-router tunnel address herdlets dial (host:7444); HERD_S3 (s3://bucket[/prefix]) and HERD_S3_ENDPOINT, with
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY, keep snapshots in that bucket (empty HERD_S3: the -snapshots directory).
# Rendered by deploy/artifacts; edit the template, not this file.
[Unit]
Description=herd-api
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/herd/herd-api.env
ExecStart=/usr/local/bin/herd-api -listen 0.0.0.0:7443 -key-file /etc/herd/jwt.key \
    -store bolt:/var/lib/herd/herd.db -snapshots /var/lib/herd/snapshots -advertise-tunnel ${HERD_ADVERTISE_TUNNEL} \
    -s3 ${HERD_S3} -s3-endpoint ${HERD_S3_ENDPOINT}
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
