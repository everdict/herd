# herd-router beside herd-api (docs/runbooks/join.md): spiffe://<td>/herd/router from the host's SPIRE agent, the
# workloads' grants in /etc/herd/spiffe-policy.json (ADR 0001 A-60).
# Rendered by deploy/artifacts; edit the template, not this file.
[Unit]
Description=herd-router
After=herd-api.service

[Service]
User=herd-router
ExecStart=/usr/local/bin/herd-router -listen 0.0.0.0:8443 -tunnel-listen 0.0.0.0:7444 -api 127.0.0.1:7443
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
