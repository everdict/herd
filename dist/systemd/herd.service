# herd all-in-one: herd-api (bbolt), herd-router, herd-egress and a herdlet in one process (docs/runbooks/all-in-one.md).
# Rendered by deploy/artifacts; edit the template, not this file.
[Unit]
Description=herd all-in-one (herd-api, herd-router, herd-egress, herdlet)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/herd -data /var/lib/herd \
    -listen 0.0.0.0:7443 -router-listen 0.0.0.0:8443 -tunnel-listen 127.0.0.1:7444 \
    -kernel /usr/local/share/herd/kernel -initrd /usr/local/share/herd/initrd.img \
    -virtiofsd /usr/libexec/virtiofsd
Restart=on-failure
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
