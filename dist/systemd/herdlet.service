# herdlet on a joined host (docs/runbooks/join.md). HERD_API in /etc/herd/herdlet.env is herd-api's host:port; the
# join token in /etc/herd/join.token is used once, and later starts reuse the grant in the state directory. No
# -snapshots: the join hands the herdlet herd-api's S3 snapshot store.
# Rendered by deploy/artifacts; edit the template, not this file.
[Unit]
Description=herdlet
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/herd/herdlet.env
ExecStart=/usr/local/bin/herdlet join ${HERD_API} -token-file /etc/herd/join.token -state /var/lib/herdlet \
    -kernel /usr/local/share/herd/kernel -initrd /usr/local/share/herd/initrd.img \
    -virtiofsd /usr/local/libexec/herd/virtiofsd
Restart=on-failure
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
