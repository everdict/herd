<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- herd all-in-one on a Mac (docs/runbooks/all-in-one.md). -secrets is the directory the herdlet's in-process
     herd-egress resolves ate-secret://dir/<name>/<tail> credentials from, and registry-auth.json (0600,
     a docker config file) the registry logins for private template images; without it pulls are anonymous. Rendered by
     deploy/artifacts; edit the template. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.everdict.herd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/herd</string>
		<string>-data</string>
		<string>/usr/local/var/herd</string>
		<string>-listen</string>
		<string>0.0.0.0:7443</string>
		<string>-router-listen</string>
		<string>0.0.0.0:8443</string>
		<string>-kernel</string>
		<string>/usr/local/share/herd/kernel</string>
		<string>-initrd</string>
		<string>/usr/local/share/herd/initrd.img</string>
		<string>-secrets</string>
		<string>/usr/local/etc/herd/secrets</string>
		<string>-registry-auth</string>
		<string>/usr/local/etc/herd/registry-auth.json</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/log/herd.log</string>
</dict>
</plist>
