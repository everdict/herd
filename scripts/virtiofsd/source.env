# The virtiofsd herd's Linux release archives carry (ADR 0001 A-27): herd starts it with --migration-mode, so it must be
# >= 1.11, and Ubuntu 24.04 LTS ships 1.10. Upstream source at a pinned tag; build.sh refuses a checkout whose commit
# is not VIRTIOFSD_COMMIT, and builds with cargo --locked, so every crate is checked against Cargo.lock's checksums.
VIRTIOFSD_VERSION=1.13.2
VIRTIOFSD_REPO=https://gitlab.com/virtio-fs/virtiofsd.git
VIRTIOFSD_REF=v1.13.2
VIRTIOFSD_COMMIT=720245d0857e9837484488ff69c2f8c577466851
# The container it is built in: upstream's CI builds its static binary on rust:alpine (musl, static libseccomp and
# libcap-ng).
VIRTIOFSD_IMAGE=rust:1.99.1-alpine3.22
